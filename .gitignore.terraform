###################################################### 
# Common files that should be ignored in all projects
######################################################
# OS Files
.DS_Store

# Logs
*.log

# Temporary files
*.tmp
*~
*.bak

# Environment files (containing secrets, API keys, credentials)
.env
*.env
.env.*
.devcontainer/devcontainer.env

# Local configuration that shouldn't be shared
*.local

##################
# Claude AI files
##################
.claude


############
# Terraform 
############
# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc
