# Copy this file to devcontainer.env and fill in your credentials.
# devcontainer.env is excluded from git via .gitignore — never commit real credentials.

BTP_USERNAME=*user name of a BTP administrator*
BTP_PASSWORD=*password of the BTP administrator*
CF_USER=*user name of a administrator to be used for Cloud Foundry operations*
CF_PASSWORD=*password of the administrator*
CF_ORIGIN=*origin name of the identity provider to be used for authentication to Cloud Foundry API endpoint*
SCI_USERNAME=*user name of administrator in SAP Cloud Identity Services*
SCI_PASSWORD=*password of the administrator user*
SCI_CLIENT_ID=*oAuth Client ID of a system user in SAP Cloud Identity Services*
SCI_CLIENT_SECRET=*oAuth Client Secret of the system user*
AWS_ACCESS_KEY_ID=*access_key_id from service key of the SAP Object Store Service*
AWS_SECRET_ACCESS_KEY=*secret_access_key from service key of the SAP Object Store Service*
